{
  "//": "Lighthouse CI gate. Run: npm run build && npx @lhci/cli@0.14.x autorun. Thresholds are the ones agreed for the rebuild; lab metrics stand in for the field ones where Lighthouse cannot measure them (INP is interaction-driven, so TBT is the lab proxy). Core Web Vitals should still be judged at the 75th percentile of real users in Search Console / CrUX - this file only stops a regression reaching production.",
  "ci": {
    "collect": {
      "startServerCommand": "node server.js",
      "startServerReadyPattern": "serving",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/capabilities",
        "http://localhost:8080/capabilities/geospatial-mapping",
        "http://localhost:8080/industries/utilities",
        "http://localhost:8080/work",
        "http://localhost:8080/work/multi-country-mapping",
        "http://localhost:8080/contact",
        "http://localhost:8080/insights"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "uses-responsive-images": "warn",
        "modern-image-formats": "warn",
        "unused-javascript": "warn",
        "target-size": "error",
        "color-contrast": "error",
        "heading-order": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
