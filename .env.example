# Copy to .env for local development, or set these as Railway service variables.

# Base URL for the content API (blogs, jobs, admin).
# Leave unset to use the same-origin /api path, which is how the cPanel/PHP
# deployment works. On Railway there is no PHP runtime, so point this at
# wherever the PHP API is hosted, e.g. https://www.jsanconsulting.com/api
# VITE_API_BASE=https://www.jsanconsulting.com/api

# MapTiler key used by the interactive world map.
# VITE_MAPTILER_KEY=your-key-here
