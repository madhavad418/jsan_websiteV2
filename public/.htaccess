# JSAN Website - Apache config for cPanel hosting
# Single-page-app rewrite + compression + caching + security headers

Options -MultiViews
DirectoryIndex index.html

# Don't auto-redirect "/dir" -> "/dir/". SPA routes (e.g. /blogs, /services)
# must not be shadowed by a same-named server directory, which would 301 to the
# directory and then 403 (directory listing is disabled).
DirectorySlash Off

# ----------------------------------------------------------------------
# SPA routing: serve index.html for any path that isn't a real FILE.
# Real files (hashed assets, images under /blogs, /uploads, /pillars, PHP under
# /api, etc.) are served directly; everything else  including routes whose name
# collides with a real server directory  falls through to the React app.
# (We intentionally do NOT pass real directories through: a bare /blogs or
# /services must render the app, not the folder.)
# ----------------------------------------------------------------------
# ===== GENERATED REDIRECTS (scripts/sync-redirects.mjs) - do not edit by hand =====

RedirectMatch 301 ^/capabilities/application-support/?$ /capabilities/esri-gis-application-development
RedirectMatch 301 ^/capabilities/esri-platform-support/?$ /capabilities/esri-gis-application-development
RedirectMatch 301 ^/capabilities/arcgis-solution-development/?$ /capabilities/esri-gis-application-development
RedirectMatch 301 ^/capabilities/geodatabase-data-modelling/?$ /capabilities/esri-gis-application-development
RedirectMatch 301 ^/capabilities/arcgis-field-operations/?$ /capabilities/esri-gis-application-development
RedirectMatch 301 ^/capabilities/scan-to-bim/?$ /capabilities/bim-digital-twin-engineering
RedirectMatch 301 ^/capabilities/bim-gis-integration/?$ /capabilities/bim-digital-twin-engineering
RedirectMatch 301 ^/capabilities/digital-twin-asset-information/?$ /capabilities/bim-digital-twin-engineering
RedirectMatch 301 ^/capabilities/integration-services/?$ /capabilities/spatial-apis-systems-integration
RedirectMatch 301 ^/capabilities/telecom-infrastructure/?$ /capabilities/lidar-3d-intelligence
RedirectMatch 301 ^/capabilities/geoai-data-operations/?$ /capabilities/visual-ai-assisted-data-annotation
RedirectMatch 301 ^/services/geospatial/aerial-surveys/?$ /capabilities/aerial-drone-lidar-mapping
RedirectMatch 301 ^/services/geospatial/digital-twins/?$ /capabilities/3d-modelling-digital-twins
RedirectMatch 301 ^/services/location-intelligence/navigation-data/?$ /capabilities/navigation-data
RedirectMatch 301 ^/services/geospatial/spatial-analytics/?$ /capabilities/spatial-analysis
RedirectMatch 301 ^/services/geospatial/enterprise-gis/?$ /capabilities/enterprise-gis-data-management
RedirectMatch 301 ^/services/geospatial/remote-sensing/?$ /capabilities/remote-sensing-earth-observation
RedirectMatch 301 ^/services/location-intelligence/data-capture/?$ /capabilities/geospatial-data-capture
RedirectMatch 301 ^/about/?$ /company
RedirectMatch 301 ^/blogs/?$ /insights
RedirectMatch 301 ^/projects/?$ /products
RedirectMatch 301 ^/capabilities/gis-tools-support/?$ /capabilities/esri-gis-application-development
RedirectMatch 301 ^/news/?$ /insights
RedirectMatch 301 ^/industries/energy/?$ /industries/utilities
RedirectMatch 301 ^/industries/transport/?$ /industries/transportation-infrastructure
RedirectMatch 301 ^/industries/smartcities/?$ /industries/government-smart-cities
RedirectMatch 301 ^/capabilities/utilities-mapping/?$ /services/utility-network-intelligence
RedirectMatch 301 ^/services/location-intelligence/advance-analytics/?$ /services/location-intelligence/advanced-analytics
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^About\.html$ /company [R=301,NC,L]
RewriteRule ^company/About-Us\.html$ /company [R=301,NC,L]
RewriteRule ^Contact\.html$ /contact [R=301,NC,L]
RewriteRule ^contact/Contact-form\.html$ /contact [R=301,NC,L]
RewriteRule ^Locations\.html$ /contact [R=301,NC,L]
RewriteRule ^contact/Locations\.html$ /contact [R=301,NC,L]
RewriteRule ^Privacy-Policy\.html$ /privacy-policy [R=301,NC,L]
RewriteRule ^Services\.html$ /services [R=301,NC,L]
RewriteRule ^Technologies\.html$ /technologies [R=301,NC,L]
RewriteRule ^services/Business-Advisory\.html$ /services/business-advisory [R=301,NC,L]
RewriteRule ^services/GIS\.html$ /services/geospatial [R=301,NC,L]
RewriteRule ^services/Programme-Management\.html$ /services/program-management [R=301,NC,L]
RewriteRule ^services/Staffing-Solutions\.html$ /services/staffing-solutions [R=301,NC,L]
RewriteRule ^services/Technology-Consultancy\.html$ /services/technology-consultancy [R=301,NC,L]
RewriteRule ^technologies/API-Integration\.html$ /technologies/api-integration [R=301,NC,L]
RewriteRule ^technologies/Analytics-Information-Management\.html$ /technologies/analytics [R=301,NC,L]
RewriteRule ^technologies/Cloud-Technologies\.html$ /technologies/cloud [R=301,NC,L]
RewriteRule ^technologies/Cyber-Security\.html$ /technologies/cyber-security [R=301,NC,L]
RewriteRule ^technologies/Data-warehouse\.html$ /technologies/data-warehouse [R=301,NC,L]
RewriteRule ^technologies/DevOps\.html$ /technologies/devops [R=301,NC,L]
RewriteRule ^technologies/ERP-SAP-P_Soft-Oracle_Siebel-Ariba\.html$ /services/erp [R=301,NC,L]
RewriteRule ^technologies/GIS-Technologies\.html$ /technologies/gis [R=301,NC,L]
RewriteRule ^technologies/IT-Infrastructure-and-Managed-Services\.html$ /technologies/it-infrastructure [R=301,NC,L]
RewriteRule ^technologies/Intelligent-automation-and-robotics\.html$ /technologies/automation [R=301,NC,L]
RewriteRule ^technologies/Web-Technologies\.html$ /technologies/web [R=301,NC,L]
RedirectMatch 301 ^/industires/?$ /industries
RedirectMatch 301 ^/feed/?$ /insights

# Unknown ids in data-driven sections: real 404 (ErrorDocument serves the SPA).
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/news/[^/]+/?$
RewriteCond %{REQUEST_URI} !^/news/(jsan-atlas-ops|jsan-launches-modern-vehicle-tracking-platform)/?$
RewriteRule ^ - [R=404,L]
RewriteCond %{REQUEST_URI} ^/work/[^/]+/?$
RewriteCond %{REQUEST_URI} !^/work/(multi-country-mapping|lidar-infrastructure-intelligence|telecom-network-engineering)/?$
RewriteRule ^ - [R=404,L]
RewriteCond %{REQUEST_URI} ^/technologies/[^/]+/?$
RewriteCond %{REQUEST_URI} !^/technologies/(gis|api-integration|analytics|cloud|cyber-security|data-warehouse|devops|automation|it-infrastructure|web)/?$
RewriteRule ^ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.html$ - [R=404,L]

# ===== END GENERATED REDIRECTS =====

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files directly.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Otherwise hand off to the React app.
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Deflate compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# Pre-compressed brotli/gzip variants if Vite plugin produces them later
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html|svg|json|xml)\.br$">
    Header set Content-Encoding br
  </FilesMatch>
  <FilesMatch "\.(js|css|html|svg|json|xml)\.gz$">
    Header set Content-Encoding gzip
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Cache headers
#  - Vite hashes JS/CSS/asset filenames -> safe to cache 1 year, immutable
#  - HTML must always re-validate so users get the newest deploy
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/json              "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/xml                      "access plus 1 hour"

  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"

  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/gif                     "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"

  ExpiresByType font/ttf                      "access plus 1 year"
  ExpiresByType font/otf                      "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"

  ExpiresByType video/mp4                     "access plus 1 month"
  ExpiresByType video/webm                    "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Public images keep stable filenames; revalidate them after a day so replacements
  # do not remain stuck in visitors' caches for a year.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # Only content-hashed Vite filenames are safe to mark immutable.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|ttf|otf|eot|jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # /optimized/ files are named by a hash of their source image, so a changed image
  # always gets a new URL - they can be cached forever like Vite's hashed assets.
  <If "%{REQUEST_URI} =~ m#^/optimized/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # index.html must never be cached so deploys are picked up immediately
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# MIME types (cPanel sometimes misses these)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript            .js .mjs
  AddType text/css                          .css
  AddType image/svg+xml                     .svg .svgz
  AddType image/webp                        .webp
  AddType image/avif                        .avif
  AddType font/woff                         .woff
  AddType font/woff2                        .woff2
  AddType application/manifest+json         .webmanifest
  AddType application/wasm                  .wasm
  AddType video/mp4                         .mp4
  AddType video/webm                        .webm
  AddEncoding gzip                          .gz
  AddEncoding br                            .br
</IfModule>

# ----------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  # Uncomment after confirming HTTPS is fully set up in cPanel:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ----------------------------------------------------------------------
# Block access to source/config files in case they get uploaded
# ----------------------------------------------------------------------
<FilesMatch "(^\.|package(-lock)?\.json|tsconfig.*\.json|vite\.config\..*|postcss\.config\..*|tailwind\.config\..*|\.env.*|\.git.*)$">
  Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Force HTTPS - safe to leave commented if cPanel "Force HTTPS Redirect"
# is already on. Uncomment to enforce at .htaccess level instead.
# ----------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# Custom 404 -> SPA handles it via React Router
ErrorDocument 404 /index.html
